# Normalise line endings; keep binaries untouched.
* text=auto eol=lf
*.png binary
*.ogg binary

# Asset Library and GitHub zip downloads contain only addons/ (which has its own README and licence copy).
/.gitattributes export-ignore
/.gitignore export-ignore
/README.md export-ignore
/ASSETLIB.md export-ignore
/TESTING.md export-ignore
/LICENSE export-ignore
/LICENSE-CODE export-ignore
/icon.png export-ignore
/screenshot.png export-ignore
/project.godot export-ignore
/tests export-ignore
